<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      prefHeight="800"
      prefWidth="1500"
      spacing="20"
      style="-fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.shopflowers.controller.graphic.LoginGraphicController">

    <HBox alignment="CENTER" prefHeight="100.0" prefWidth="778.0" spacing="20">
        <Label alignment="CENTER"
               contentDisplay="CENTER"
               prefHeight="100.0"
               prefWidth="262.0"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"
               text="IERUSSI FLOWERS"
               textAlignment="CENTER" />

        <MenuButton fx:id="modeMenuButton"
                    alignment="CENTER"
                    contentDisplay="CENTER"
                    prefWidth="40.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #2b2f34; -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 0; -fx-border-radius: 0; -fx-padding: 0; -fx-cursor: hand;"
                    text="⚙">
            <items>
                <MenuItem text="DEMO" onAction="#handleSetDemoMode" />
                <MenuItem text="FILE" onAction="#handleSetFileMode" />
                <MenuItem text="FULL" onAction="#handleSetFullMode" />
            </items>
        </MenuButton>
    </HBox>

    <HBox prefHeight="182.0" prefWidth="1439.0">
        <GridPane alignment="CENTER" hgap="10" prefHeight="94.0" prefWidth="1440.0" vgap="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="usernameField"
                       promptText="username utente"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1" />

            <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="passwordField" promptText="Password" />
                    <TextField fx:id="visiblePasswordField"
                               managed="false"
                               promptText="Password"
                               visible="false" />
                </StackPane>
                <Button text="👁" focusTraversable="false" onAction="#handleTogglePassword" />
            </HBox>

            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Button text="Login" onAction="#handleLogin" />
                <Button text="Registrati" onAction="#handleGoToRegister" />
                <Button text="Accedi come ospite" onAction="#handleGuestAccess" />
            </HBox>

            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <Hyperlink alignment="CENTER"
                           prefHeight="24.0"
                           prefWidth="254.0"
                           text="Cambia password"
                           onAction="#handleGoToChangePassword" />
            </VBox>

            <columnConstraints>
                <ColumnConstraints />
                <ColumnConstraints />
                <ColumnConstraints />
                <ColumnConstraints />
            </columnConstraints>

            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
        </GridPane>
    </HBox>

    <Label fx:id="messageLabel" text="" />
</VBox>