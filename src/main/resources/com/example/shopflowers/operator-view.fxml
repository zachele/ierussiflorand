<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.shopflowers.controller.graphic.OperatorGraphicController"
      spacing="15"
      prefWidth="1000"
      prefHeight="650"
      style="-fx-padding: 20;">

    <MenuBar>
        <Menu text="Impostazione">
            <MenuItem text="Logout" onAction="#handleLogout"/>
        </Menu>
    </MenuBar>

    <Label text="Area Operatore - Gestione Ordini"
           style="-fx-font-size: 22px; -fx-font-weight: bold;" />

    <Label text="Ordini effettuati"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TableView fx:id="orderTable" prefHeight="250">
        <columns>
            <TableColumn fx:id="orderIdColumn" text="ID Ordine" prefWidth="90" />
            <TableColumn fx:id="usernameColumn" text="Cliente" prefWidth="140" />
            <TableColumn fx:id="deliveryColumn" text="Consegna" prefWidth="120" />
            <TableColumn fx:id="paymentColumn" text="Pagamento" prefWidth="140" />
            <TableColumn fx:id="totalColumn" text="Totale" prefWidth="100" />
            <TableColumn fx:id="dateColumn" text="Data" prefWidth="220" />
        </columns>
    </TableView>

    <Label text="Dettagli ordine selezionato"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TableView fx:id="orderItemsTable" prefHeight="220">
        <columns>
            <TableColumn fx:id="productColumn" text="Prodotto" prefWidth="250" />
            <TableColumn fx:id="quantityColumn" text="Quantità" prefWidth="120" />
            <TableColumn fx:id="unitPriceColumn" text="Prezzo unitario" prefWidth="150" />
        </columns>
    </TableView>

    <Label fx:id="messageLabel" text="" />

</VBox>