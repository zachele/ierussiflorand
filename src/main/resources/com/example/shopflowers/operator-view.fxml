<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.shopflowers.controller.graphic.OperatorGraphicController"
      spacing="15"
      prefWidth="1500"
      prefHeight="800"
      style="-fx-padding: 20;">

    <MenuBar>
        <Menu text="Impostazioni">
            <MenuItem text="Logout" onAction="#handleLogout"/>
        </Menu>
    </MenuBar>

    <Label text="Area Operatore - Gestione Ordini"
           style="-fx-font-size: 22px; -fx-font-weight: bold;" />

    <Label text="Ordini effettuati"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <HBox spacing="12">
        <TextField fx:id="searchField" promptText="Cerca per nome, cognome, cliente, consegna, pagamento o stato" prefWidth="380"/>
        <ComboBox fx:id="statusFilterComboBox" prefWidth="180"/>
    </HBox>

    <TableView fx:id="orderTable" prefHeight="250">
        <columns>
            <TableColumn fx:id="orderIdColumn" text="ID Ordine" prefWidth="80" />
            <TableColumn fx:id="nameColumn" text="Nome" prefWidth="110" />
            <TableColumn fx:id="surnameColumn" text="Cognome" prefWidth="110" />
            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="130" />
            <TableColumn fx:id="deliveryColumn" text="Consegna" prefWidth="110" />
            <TableColumn fx:id="paymentColumn" text="Pagamento" prefWidth="120" />
            <TableColumn fx:id="statusColumn" text="Stato attuale" prefWidth="140" />
            <TableColumn fx:id="totalColumn" text="Totale" prefWidth="90" />
            <TableColumn fx:id="dateColumn" text="Data" prefWidth="200" />
        </columns>
    </TableView>

    <HBox spacing="10">
        <Label text="Stato ordine:" />
        <ComboBox fx:id="statusComboBox" prefWidth="180" />
        <Button text="Aggiorna stato" onAction="#handleUpdateStatus" />
        <Button text="Ordini attivi" onAction="#handleShowActiveOrders" />
        <Button text="Ordini completati" onAction="#handleShowCompletedOrders" />
    </HBox>

    <Label text="Dettagli ordine selezionato"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TableView fx:id="orderItemsTable" prefHeight="220">
        <columns>
            <TableColumn fx:id="productColumn" text="Prodotto" prefWidth="250" />
            <TableColumn fx:id="quantityColumn" text="Quantità" prefWidth="120" />
            <TableColumn fx:id="unitPriceColumn" text="Prezzo unitario" prefWidth="150" />
        </columns>
    </TableView>

    <Label fx:id="bouquetDetailsLabel"
           text="Questo ordine non contiene un bouquet personalizzato."
           wrapText="true"
           style="-fx-font-size: 14px;" />

    <Label fx:id="messageLabel" text="" />

</VBox>