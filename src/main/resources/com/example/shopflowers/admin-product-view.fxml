<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="800" prefWidth="1500" spacing="15"
      style="-fx-padding: 20;"
      stylesheets="@../../../Style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.shopflowers.controller.graphic.AdminProductGraphicController">

    <MenuBar>
        <Menu text="Gestione">
            <MenuItem text="Prodotti"/>
            <MenuItem text="Nuovo operatore" onAction="#handleGoToOperatorManagement"/>
            <MenuItem text="Statistiche vendite" onAction="#handleGoToStatistics"/>
            <MenuItem text="Logout" onAction="#handleLogout"/>
        </Menu>
    </MenuBar>

    <Label text="GESTIONE PRODOTTI ADMIN"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane alignment="CENTER" hgap="10" vgap="10">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <TextField fx:id="nameField"
                   promptText="NOME"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <TextField fx:id="priceField"
                   promptText="PREZZO"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <TextField fx:id="colorField"
                   promptText="COLORE"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <TextField fx:id="varietyField"
                   promptText="VARIETA'"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

        <TextField fx:id="stockField"
                   promptText="STOCK"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>

        <ComboBox fx:id="imageComboBox"
                  prefWidth="450"
                  promptText="Seleziona immagine prodotto"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="5"/>

        <HBox spacing="10"
              GridPane.columnIndex="1"
              GridPane.rowIndex="6">
            <Button text="Aggiungi prodotto"
                    onAction="#handleAddProduct"
                    styleClass="beige-button"/>

            <Button text="Aggiorna prodotto"
                    onAction="#handleUpdateProduct"
                    styleClass="beige-button"/>

            <Button text="Elimina prodotto"
                    onAction="#handleDeleteProduct"
                    styleClass="beige-button"/>
        </HBox>

        <columnConstraints>
            <ColumnConstraints prefWidth="0"/>
            <ColumnConstraints prefWidth="450"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
        </rowConstraints>
    </GridPane>

    <HBox alignment="CENTER" spacing="12">
        <TextField fx:id="searchField"
                   prefWidth="260"
                   promptText="Cerca per nome, colore o varietà"/>

        <ComboBox fx:id="colorFilterComboBox"
                  prefWidth="160"/>

        <CheckBox fx:id="availableOnlyCheckBox"
                  text="Solo disponibili"/>
    </HBox>

    <TableView fx:id="productTable" prefHeight="366" prefWidth="1460">
        <columns>
            <TableColumn fx:id="idColumn" text="ID"/>
            <TableColumn fx:id="nameColumn" text="Nome"/>
            <TableColumn fx:id="priceColumn" text="Prezzo"/>
            <TableColumn fx:id="colorColumn" text="Colore"/>
            <TableColumn fx:id="varietyColumn" text="Varietà"/>
            <TableColumn fx:id="stockColumn" text="Stock"/>
        </columns>
    </TableView>

    <Label fx:id="messageLabel"/>
</VBox>