<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800" prefWidth="1500" spacing="15" style="-fx-padding: 20;" stylesheets="@../../../Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.shopflowers.controller.graphic.CartGraphicController">

    <MenuBar prefHeight="42.0" prefWidth="1460.0">
        <Menu text="Navigazione">
            <MenuItem onAction="#handleBackToCatalog" text="Torna al catalogo" />
            <MenuItem onAction="#handleLogout" text="Logout" />
        </Menu>
    </MenuBar>

    <VBox spacing="6">
        <Label alignment="CENTER" prefHeight="31.0" prefWidth="1467.0" style="-fx-font-size: 26px; -fx-font-weight: bold;" styleClass="info-label" text="🛒 Carrello Cliente" />
        <Label alignment="CENTER" prefHeight="16.0" prefWidth="1466.0" style="-fx-font-size: 14px;" text="Riepilogo degli articoli selezionati prima del checkout" />
    </VBox>

    <Separator />

    <VBox spacing="8" />

    <TableView fx:id="cartTable" prefHeight="381.0" prefWidth="1460.0">
        <columns>
            <TableColumn fx:id="cartNameColumn" prefWidth="350" text="Prodotto" />
            <TableColumn fx:id="cartQuantityColumn" prefWidth="180" text="Quantità" />
            <TableColumn fx:id="cartTotalColumn" prefWidth="220" text="Totale" />
        </columns>
    </TableView>

    <VBox spacing="8">
        <Label prefHeight="22.0" prefWidth="234.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Bouquet personalizzato:" />

        <Label fx:id="bouquetInfoLabel" style="-fx-font-size: 14px;" styleClass="info-label" text="Nessun bouquet personalizzato nel carrello." wrapText="true" />
    </VBox>

    <Label fx:id="totalLabel" alignment="CENTER" prefHeight="39.0" prefWidth="1537.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" styleClass="text-field" text="Totale carrello: € 0.00" />

    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#handleRemoveSelected" styleClass="beige-button" text="Rimuovi selezionato" />
        <Button onAction="#handleClearCart" styleClass="beige-button" text="Svuota carrello" />
        <Button onAction="#handleGoToCheckout" styleClass="beige-button" text="Vai al checkout" />
    </HBox>

    <Label fx:id="messageLabel" text="" />
</VBox>
