<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.shopflowers.controller.graphic.CartGraphicController"
      spacing="15"
      prefWidth="1500"
      prefHeight="800"
      stylesheets="@../../../Style.css"
      style="-fx-padding: 20;">

    <MenuBar>
        <Menu text="Navigazione">
            <MenuItem text="Torna al catalogo" onAction="#handleBackToCatalog"/>
            <MenuItem text="Logout" onAction="#handleLogout"/>
        </Menu>
    </MenuBar>

    <VBox spacing="6">
        <Label text="🛒 Carrello Cliente" styleClass="title-label"/>
        <Label text="Riepilogo degli articoli selezionati prima del checkout"
               styleClass="info-label"/>
    </VBox>

    <Separator />

    <VBox spacing="8">
        <Label text="Stato carrello" styleClass="section-label"/>
        <Label fx:id="cartTimerLabel"
               text="Vai al checkout per attivare o proseguire il timer carrello."
               styleClass="info-label"/>
    </VBox>

    <TableView fx:id="cartTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="cartImageColumn" text="Immagine" prefWidth="90"/>
            <TableColumn fx:id="cartNameColumn" text="Prodotto" prefWidth="320"/>
            <TableColumn fx:id="cartQuantityColumn" text="Quantità" prefWidth="150"/>
            <TableColumn fx:id="cartTotalColumn" text="Totale" prefWidth="180"/>
        </columns>
    </TableView>

    <VBox spacing="8">
        <Label text="Bouquet personalizzato" styleClass="section-label"/>
        <Label fx:id="bouquetInfoLabel"
               text="Nessun bouquet personalizzato nel carrello."
               wrapText="true"
               styleClass="info-label"/>
    </VBox>

    <Label fx:id="totalLabel"
           text="Totale carrello: € 0.00"
           styleClass="section-label"/>

    <HBox spacing="10">
        <Button text="Rimuovi selezionato" onAction="#handleRemoveSelected" styleClass="beige-button"/>
        <Button text="Svuota carrello" onAction="#handleClearCart" styleClass="beige-button"/>
        <Button text="Vai al checkout" onAction="#handleGoToCheckout" styleClass="beige-button"/>
    </HBox>

    <Label fx:id="messageLabel" styleClass="message-label"/>
</VBox>