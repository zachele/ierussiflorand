<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800" prefWidth="1500" spacing="15" style="-fx-padding: 20;" stylesheets="@../../../Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.shopflowers.controller.graphic.CheckoutGraphicController">

    <MenuBar>
        <Menu text="Impostazioni">
            <MenuItem onAction="#handleBackToCatalog" text="Torna al catalogo" />
            <MenuItem onAction="#handleLogout" text="Logout" />
        </Menu>
    </MenuBar>

    <Label alignment="CENTER" prefHeight="27.0" prefWidth="1491.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="CHECKOUT CLIENTE" />

    <TableView fx:id="checkoutTable" prefHeight="200">
        <columns>
            <TableColumn fx:id="productColumn" prefWidth="558.4000053405762" text="Prodotto" />
            <TableColumn fx:id="quantityColumn" prefWidth="501.59991455078125" text="Quantità" />
            <TableColumn fx:id="totalColumn" prefWidth="393.60003662109375" text="Totale" />
        </columns>
    </TableView>

    <Label fx:id="bouquetInfoLabel" alignment="TOP_LEFT" prefHeight="26.0" prefWidth="524.0" style="-fx-font-size: 14px;" styleClass="text" text="Nessun bouquet personalizzato nel pagamento corrente." wrapText="true" />

    <Label fx:id="totalLabel" alignment="CENTER" prefHeight="20.0" prefWidth="1474.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" styleClass="text-field" text="Totale ordine: € 0.0" />
    <ComboBox fx:id="deliveryModeComboBox" prefHeight="42.0" prefWidth="238.0" promptText="MODALITA' DI CONSEGNA" />
    <TextField fx:id="addressField" promptText="Indirizzo per la consegna" />

    <HBox alignment="CENTER" spacing="20">
         <DatePicker fx:id="pickupDatePicker" prefWidth="180" promptText=" DATA RITIRO" styleClass="date-picker" />
         <ComboBox fx:id="pickupTimeComboBox" prefHeight="42.0" prefWidth="274.0" promptText="ORA RITIRO" />
    </HBox>

    <Label alignment="TOP_LEFT" prefHeight="45.0" prefWidth="312.0" styleClass="title-label" text="Metodo di pagamento:" />
    <TextField fx:id="paymentField" prefHeight="64.0" prefWidth="1460.0" promptText="Es. Carta, PayPal, Contanti" />

    <HBox alignment="CENTER" spacing="12">
        <Button onAction="#handleConfirmOrder" styleClass="beige-button" text="Conferma ordine" />
        <Button onAction="#handleRemoveBouquet" styleClass="beige-button" text="Rimuovi bouquet" />
        <Button onAction="#handleBackToCatalog" styleClass="beige-button" text="Torna al catalogo" />
        <Button onAction="#handleLogout" styleClass="beige-button" text="Logout" />
    </HBox>

    <Label fx:id="messageLabel" text="" />
</VBox>
