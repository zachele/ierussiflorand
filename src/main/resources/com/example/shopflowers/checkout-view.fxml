<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.shopflowers.controller.graphic.CheckoutGraphicController"
      spacing="15"
      prefWidth="800"
      prefHeight="550"
      style="-fx-padding: 20;">

    <Label text="Checkout Cliente"
           style="-fx-font-size: 22px; -fx-font-weight: bold;" />

    <TableView fx:id="checkoutTable" prefHeight="250">
        <columns>
            <TableColumn fx:id="productColumn" text="Prodotto" prefWidth="250" />
            <TableColumn fx:id="quantityColumn" text="Quantità" prefWidth="120" />
            <TableColumn fx:id="totalColumn" text="Totale" prefWidth="150" />
        </columns>
    </TableView>

    <Label fx:id="totalLabel" text="Totale ordine: € 0.0" />

    <Label text="Modalità di consegna:" />
    <ComboBox fx:id="deliveryModeComboBox" prefWidth="200" />

    <Label text="Indirizzo di consegna:" />
    <TextField fx:id="addressField" promptText="Inserisci indirizzo solo per consegna" />

    <Label text="Metodo di pagamento:" />
    <TextField fx:id="paymentField" promptText="Es. Carta, PayPal, Contanti" />

    <HBox spacing="10">
        <Button text="Conferma ordine" onAction="#handleConfirmOrder" />
        <Button text="Torna al catalogo" onAction="#handleBackToCatalog" />
        <Button text="Logout" onAction="#handleLogout" />
    </HBox>

    <Label fx:id="messageLabel" text="" />

</VBox>