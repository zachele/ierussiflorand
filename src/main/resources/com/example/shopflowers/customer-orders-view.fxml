<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800" prefWidth="1500" spacing="15" style="-fx-padding: 20;" stylesheets="@../../../Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.shopflowers.controller.graphic.CustomerOrdersGraphicController">

    <HBox alignment="CENTER" spacing="15">
        <Button onAction="#handleBackToCatalog" styleClass="beige-button" text="Torna al catalogo" />
        <Label alignment="CENTER" prefHeight="26.0" prefWidth="167.0" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="I MIEI ORDINI" />
        <Button onAction="#handleLogout" prefHeight="32.0" prefWidth="98.0" styleClass="beige-button" text="Logout" />
    </HBox>

    <HBox spacing="12">
   
       <Label alignment="CENTER" prefHeight="42.0" prefWidth="226.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Ordini effettuati:" />
        <ComboBox fx:id="statusFilterComboBox" prefHeight="42.0" prefWidth="177.0" styleClass="combo-box" />
    </HBox>

    <TableView fx:id="orderTable" prefHeight="260">
        <columns>
            <TableColumn fx:id="orderIdColumn" prefWidth="90" text="ID Ordine" />
            <TableColumn fx:id="deliveryColumn" prefWidth="120" text="Modalità" />
            <TableColumn fx:id="addressColumn" prefWidth="220" text="Indirizzo" />
            <TableColumn fx:id="pickupDateColumn" prefWidth="158.4000244140625" text="Data ritiro" />
            <TableColumn fx:id="pickupTimeColumn" prefWidth="158.39996337890625" text="Ora ritiro" />
            <TableColumn fx:id="paymentColumn" prefWidth="156.800048828125" text="Pagamento" />
            <TableColumn fx:id="totalColumn" prefWidth="179.199951171875" text="Totale" />
            <TableColumn fx:id="dateColumn" prefWidth="191.199951171875" text="Data ordine" />
            <TableColumn fx:id="statusColumn" prefWidth="182.4000244140625" text="Stato" />
        </columns>
    </TableView>

    <Label alignment="CENTER" prefHeight="22.0" prefWidth="1665.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Dettagli ordine selezionato" />

    <TableView fx:id="orderItemsTable" prefHeight="220">
        <columns>
            <TableColumn fx:id="productColumn" prefWidth="545.600025177002" text="Prodotto" />
            <TableColumn fx:id="quantityColumn" prefWidth="466.4000244140625" text="Quantità" />
            <TableColumn fx:id="unitPriceColumn" prefWidth="445.60003662109375" text="Prezzo unitario" />
        </columns>
    </TableView>

    <Label fx:id="bouquetDetailsLabel" alignment="CENTER" prefHeight="16.0" prefWidth="1573.0" style="-fx-font-size: 14px;" styleClass="text-field" text="Questo ordine non contiene un bouquet personalizzato." wrapText="true" />

    <Label fx:id="messageLabel" text="" />

</VBox>
