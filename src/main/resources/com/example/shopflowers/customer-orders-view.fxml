<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.shopflowers.controller.graphic.CustomerOrdersGraphicController"
      spacing="15"
      prefWidth="1500"
      prefHeight="800"
      style="-fx-padding: 20;">

    <HBox spacing="15">
        <Label text="I miei ordini"
               style="-fx-font-size: 22px; -fx-font-weight: bold;" />
        <Button text="Torna al catalogo" onAction="#handleBackToCatalog" />
        <Button text="Logout" onAction="#handleLogout" />
    </HBox>

    <Label text="Ordini effettuati"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TableView fx:id="orderTable" prefHeight="250">
        <columns>
            <TableColumn fx:id="orderIdColumn" text="ID Ordine" prefWidth="100" />
            <TableColumn fx:id="deliveryColumn" text="Consegna" prefWidth="140" />
            <TableColumn fx:id="paymentColumn" text="Pagamento" prefWidth="160" />
            <TableColumn fx:id="totalColumn" text="Totale" prefWidth="120" />
            <TableColumn fx:id="dateColumn" text="Data" prefWidth="240" />
            <TableColumn fx:id="statusColumn" text="Stato" prefWidth="140" />
        </columns>
    </TableView>

    <Label text="Dettagli ordine selezionato"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TableView fx:id="orderItemsTable" prefHeight="220">
        <columns>
            <TableColumn fx:id="productColumn" text="Prodotto" prefWidth="280" />
            <TableColumn fx:id="quantityColumn" text="Quantità" prefWidth="120" />
            <TableColumn fx:id="unitPriceColumn" text="Prezzo unitario" prefWidth="150" />
        </columns>
    </TableView>

    <Label fx:id="messageLabel" text="" />

</VBox>
