<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.shopflowers.controller.graphic.StatisticsGraphicController"
      spacing="15"
      prefWidth="1500"
      prefHeight="800"
      style="-fx-padding: 20;">

    <HBox spacing="15">
        <Label text="Statistiche Vendite"
               style="-fx-font-size: 22px; -fx-font-weight: bold;" />
        <Button text="Torna indietro" onAction="#handleBackToAdmin"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>

    <HBox spacing="40">

        <!-- STATISTICHE TESTUALI -->
        <VBox spacing="10">
            <Label text="Totale ordini:"/>
            <Label fx:id="totalOrdersLabel"/>

            <Label text="Totale ricavi:"/>
            <Label fx:id="totalRevenueLabel"/>

            <Label text="Ordini consegnati:"/>
            <Label fx:id="deliveredOrdersLabel"/>

            <Label text="Ordini attivi:"/>
            <Label fx:id="activeOrdersLabel"/>

            <Label text="Clienti registrati:"/>
            <Label fx:id="totalClientsLabel"/>

            <Label text="Operatori registrati:"/>
            <Label fx:id="totalOperatorsLabel"/>

            <Label text="Prodotto più venduto:"/>
            <Label fx:id="mostSoldProductLabel"/>
        </VBox>

        <!-- GRAFICO A TORTA -->
        <PieChart fx:id="statisticsPieChart" prefWidth="500" prefHeight="500"/>

    </HBox>

    <Label fx:id="messageLabel" text=""/>

</VBox>