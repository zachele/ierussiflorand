<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800" prefWidth="1500" spacing="15" style="-fx-padding: 20;" stylesheets="@../../../Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.shopflowers.controller.graphic.CustomerCatalogGraphicController">

    <MenuBar>
        <Menu text="Navigazione">
            <MenuItem onAction="#handleRecommendationAssistant" text="Assistente bouquet" />
            <MenuItem onAction="#handleCustomBouquet" text="Bouquet personalizzato" />
            <MenuItem onAction="#handleMyOrders" text="I miei ordini" />
            <MenuItem onAction="#handleCompanyInfo" text="Info azienda" />
            <MenuItem onAction="#handleLogout" text="Logout" />
        </Menu>

        <Menu text="🛒 Carrello">
            <MenuItem onAction="#handleGoToCart" text="Apri carrello" />
        </Menu>
    </MenuBar>

    <Label styleClass="title-label" text="Catalogo Cliente" />

    <HBox alignment="CENTER" spacing="12">
        <TextField fx:id="searchField" prefWidth="260" promptText="Cerca per nome, colore o varietà" />

        <ComboBox fx:id="colorFilterComboBox" prefWidth="160" />

        <CheckBox fx:id="availableOnlyCheckBox" text="Solo disponibili" />
    </HBox>

    <TableView fx:id="productTable" prefHeight="500">
        <columns>
            <TableColumn fx:id="imageColumn" prefWidth="444.0000057220459" text="Immagine" />
            <TableColumn fx:id="idColumn" minWidth="7.20001220703125" prefWidth="83.19998168945312" text="ID" />
            <TableColumn fx:id="nameColumn" prefWidth="140.00006103515625" text="Nome" />
            <TableColumn fx:id="priceColumn" prefWidth="167.2000732421875" text="Prezzo" />
            <TableColumn fx:id="colorColumn" prefWidth="164.800048828125" text="Colore" />
            <TableColumn fx:id="varietyColumn" prefWidth="240.0" text="Varietà" />
            <TableColumn fx:id="stockColumn" prefWidth="218.39996337890625" text="Stock" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="cartTimerLabel" prefWidth="500.0" styleClass="info-label" text="Timer carrello: 10:00" />

        <Label styleClass="section-label" text="Quantità:" />

        <TextField fx:id="quantityField" prefWidth="100" />

        <Button onAction="#handleAddToCart" styleClass="beige-button" text="Aggiungi al carrello" />

        <Button onAction="#handleGoToCheckout" styleClass="beige-button" text="Vai al checkout" />
    </HBox>

    <Label fx:id="messageLabel" styleClass="message-label" />

</VBox>
