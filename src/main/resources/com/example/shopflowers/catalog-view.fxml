<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.shopflowers.controller.graphic.CustomerCatalogGraphicController"
      spacing="15"
      prefWidth="900"
      prefHeight="650"
      style="-fx-padding: 20;">

    <Label text="Catalogo Cliente"
           style="-fx-font-size: 22px; -fx-font-weight: bold;" />

    <TableView fx:id="productTable" prefHeight="250">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
            <TableColumn fx:id="nameColumn" text="Nome" prefWidth="160" />
            <TableColumn fx:id="priceColumn" text="Prezzo" prefWidth="100" />
            <TableColumn fx:id="colorColumn" text="Colore" prefWidth="120" />
            <TableColumn fx:id="varietyColumn" text="Varietà" prefWidth="180" />
            <TableColumn fx:id="stockColumn" text="Stock" prefWidth="100" />
        </columns>
    </TableView>

    <HBox spacing="10">
        <Label text="Quantità:" />
        <TextField fx:id="quantityField" prefWidth="100" />
        <Button text="Aggiungi al carrello" onAction="#handleAddToCart" />
    </HBox>

    <Label fx:id="messageLabel" text="" />

    <Label text="Carrello"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TableView fx:id="cartTable" prefHeight="200">
        <columns>
            <TableColumn fx:id="cartNameColumn" text="Prodotto" prefWidth="250" />
            <TableColumn fx:id="cartQuantityColumn" text="Quantità" prefWidth="120" />
            <TableColumn fx:id="cartTotalColumn" text="Totale" prefWidth="150" />
        </columns>
    </TableView>

    <Label fx:id="totalLabel" text="Totale carrello: € 0.0" />

    <HBox spacing="10">
        <Button text="Rimuovi selezionato" onAction="#handleRemoveFromCart" />
        <Button text="Svuota carrello" onAction="#handleClearCart" />
        <Button text="Vai al checkout" onAction="#handleGoToCheckout" />
        <Button text="Logout" onAction="#handleLogout" />
    </HBox>
</VBox>