<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.shopflowers.controller.graphic.OperatorManagementGraphicController"
      spacing="15"
      prefWidth="1500"
      prefHeight="800"
      style="-fx-padding: 20;">

    <MenuBar>
        <Menu text="Navigazione">
            <MenuItem text="Torna ai prodotti" onAction="#handleBackToAdmin"/>
            <MenuItem text="Logout" onAction="#handleLogout"/>
        </Menu>
    </MenuBar>

    <Label text="Gestione Operatori"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <Label text="Crea o modifica operatore"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <GridPane hgap="12" vgap="12">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Cognome:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="surnameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Username:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Stipendio:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="salaryField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Anno contratto:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="contractYearField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Ore lavorative annuali:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="annualHoursField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <HBox spacing="10" GridPane.rowIndex="7" GridPane.columnIndex="1">
            <Button text="Crea operatore" onAction="#handleCreateOperator"/>
            <Button text="Aggiorna selezionato" onAction="#handleUpdateOperator"/>
            <Button text="Elimina selezionato" onAction="#handleDeleteOperator"/>
            <Button text="Torna ai prodotti" onAction="#handleBackToAdmin"/>
        </HBox>
    </GridPane>

    <Label text="Operatori registrati"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TextField fx:id="searchField"
               promptText="Cerca per nome, cognome o username"
               prefWidth="280"/>

    <TableView fx:id="operatorTable" prefHeight="260">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
            <TableColumn fx:id="nameColumn" text="Nome" prefWidth="140"/>
            <TableColumn fx:id="surnameColumn" text="Cognome" prefWidth="140"/>
            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="180"/>
            <TableColumn fx:id="salaryColumn" text="Stipendio" prefWidth="120"/>
            <TableColumn fx:id="contractYearColumn" text="Anno contratto" prefWidth="130"/>
            <TableColumn fx:id="annualHoursColumn" text="Ore annuali" prefWidth="120"/>
        </columns>
    </TableView>

    <Label fx:id="messageLabel" text="" />
</VBox>
