<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800" prefWidth="1500" spacing="15" style="-fx-padding: 20;" styleClass="app-root" stylesheets="@../../../../StyleDarkPremium.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.shopflowers.controller.graphic.CartGraphicController">

    <MenuBar nodeOrientation="RIGHT_TO_LEFT">
        <Menu text="Impostazioni">
            <MenuItem onAction="#handleBackToCatalog" text="Torna al catalogo" />
            <MenuItem onAction="#handleLogout" text="Logout" />
        </Menu>
    </MenuBar>

    <VBox spacing="6">
        <Label styleClass="title-label" text="🛒 Carrello Cliente" />
        <Label styleClass="info-label" text="Riepilogo degli articoli selezionati prima del checkout" />
    </VBox>

    <Separator />

    <VBox spacing="8">
        <Label styleClass="section-label" text="Stato carrello" />
        <Label fx:id="cartTimerLabel" styleClass="info-label" text="Vai al checkout per attivare o proseguire il timer carrello." />
    </VBox>

    <TableView fx:id="cartTable" prefHeight="353.0" prefWidth="1460.0">
        <columns>
            <TableColumn fx:id="cartImageColumn" prefWidth="90" text="Immagine" />
            <TableColumn fx:id="cartNameColumn" prefWidth="320" text="Prodotto" />
            <TableColumn fx:id="cartQuantityColumn" prefWidth="150" text="Quantità" />
            <TableColumn fx:id="cartTotalColumn" prefWidth="180" text="Totale" />
        </columns>
    </TableView>

    <VBox spacing="8">
        <Label styleClass="section-label" text="Bouquet personalizzato" />
        <Label fx:id="bouquetInfoLabel" styleClass="info-label" text="Nessun bouquet personalizzato nel carrello." wrapText="true" />
    </VBox>

    <Label fx:id="totalLabel" styleClass="section-label" text="Totale carrello: € 0.00" />

    <HBox spacing="10">
        <Button onAction="#handleRemoveSelected" styleClass="login-secondary-button" text="Rimuovi selezionato" />
        <Button onAction="#handleClearCart" styleClass="login-secondary-button" text="Svuota carrello" />
        <Button onAction="#handleGoToCheckout" styleClass="beige-button" text="Vai al pagamento" />
    </HBox>

    <Label fx:id="messageLabel" styleClass="message-label" />
</VBox>
