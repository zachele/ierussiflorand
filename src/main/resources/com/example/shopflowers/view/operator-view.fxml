<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800" prefWidth="1500" spacing="15" style="-fx-padding: 20;" stylesheets="@../../../../StyleDarkPremium.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.shopflowers.controller.graphic.OperatorGraphicController">

    <MenuBar prefHeight="20.0" prefWidth="1460.0">
        <Menu text="Impostazioni">
            <MenuItem onAction="#handleLogout" text="Logout" />
         <graphic>
            <HBox prefHeight="55.0" prefWidth="15.0" />
         </graphic>
        </Menu>
      <Menu disable="true" mnemonicParsing="false">
        <items>
          <MenuItem mnemonicParsing="false" text="Action 1" />
        </items>
         <graphic>
            <Label prefHeight="15.0" prefWidth="644.0" />
         </graphic>
      </Menu>
      <Menu mnemonicParsing="false">
         <graphic>
              <TextField fx:id="searchField" prefHeight="38.0" prefWidth="442.0" promptText="Cerca per nome, cognome, cliente, consegna, pagamento o stato" />
         </graphic>
      </Menu>
      <Menu mnemonicParsing="false">
         <graphic>
              <ComboBox fx:id="statusFilterComboBox" prefWidth="180" promptText="Filtro Stato " />
         </graphic>
      </Menu>
    </MenuBar>

    <Label alignment="CENTER" prefHeight="26.0" prefWidth="1485.0" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Area Operatore - Gestione Ordini" />

    <Label prefHeight="22.0" prefWidth="170.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Ordini effettuati:" />

    <TableView fx:id="orderTable" prefHeight="265.0" prefWidth="1460.0">
        <columns>
            <TableColumn fx:id="orderIdColumn" prefWidth="118.39999008178711" text="ID Ordine" />
            <TableColumn fx:id="nameColumn" prefWidth="192.00001525878906" text="Nome" />
            <TableColumn fx:id="surnameColumn" prefWidth="180.79998779296875" text="Cognome" />
            <TableColumn fx:id="usernameColumn" prefWidth="129.60003662109375" text="Username" />
            <TableColumn fx:id="deliveryColumn" prefWidth="178.39996337890625" text="Consegna" />
            <TableColumn fx:id="paymentColumn" prefWidth="144.0" text="Pagamento" />
            <TableColumn fx:id="statusColumn" prefWidth="259.20001220703125" text="Stato attuale" />
            <TableColumn fx:id="totalColumn" prefWidth="93.60009765625" text="Totale" />
            <TableColumn fx:id="dateColumn" prefWidth="166.39990234375" text="Data" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="10">
        <Label />
        <ComboBox fx:id="statusComboBox" prefHeight="42.0" prefWidth="226.0" promptText="Modifica stato" />
        <Button onAction="#handleUpdateStatus" styleClass="login-secondary-button" text="Aggiorna stato" />
        <Button onAction="#handleShowActiveOrders" styleClass="login-secondary-button" text="Ordini attivi" />
        <Button onAction="#handleShowCompletedOrders" styleClass="login-secondary-button" text="Ordini consegnati" />
    </HBox>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Dettagli ordine selezionato" />

    <TableView fx:id="orderItemsTable" prefHeight="220">
        <columns>
            <TableColumn fx:id="productColumn" prefWidth="459.1999931335449" text="Prodotto" />
            <TableColumn fx:id="quantityColumn" prefWidth="528.0" text="Quantità" />
            <TableColumn fx:id="unitPriceColumn" prefWidth="471.199951171875" text="Prezzo unitario" />
        </columns>
    </TableView>

    <Label fx:id="bouquetDetailsLabel" style="-fx-font-size: 14px;" text="Questo ordine non contiene un bouquet personalizzato." wrapText="true" />

    <Label fx:id="messageLabel" text="" />

</VBox>
