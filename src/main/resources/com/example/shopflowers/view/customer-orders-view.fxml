<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800" prefWidth="1500" spacing="15" style="-fx-padding: 20;" stylesheets="@../../../../StyleDarkPremium.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.shopflowers.controller.graphic.CustomerOrdersGraphicController">
   <MenuBar prefHeight="0.0" prefWidth="1460.0">
       <Menu disable="true" mnemonicParsing="false">
            <graphic>
               <Label prefHeight="15.0" prefWidth="152.0" />
            </graphic>
       </Menu>
         <Menu disable="true" mnemonicParsing="false">
            <graphic>
               <Label prefHeight="15.0" prefWidth="745.0" />
            </graphic>
         </Menu>
         <Menu mnemonicParsing="false">
            <graphic>
                 <ComboBox fx:id="statusFilterComboBox" prefHeight="42.0" prefWidth="177.0" promptText="Ordini effettuati:" styleClass="combo-box" />
            </graphic>
         </Menu>
       <Menu mnemonicParsing="false">
            <graphic>
                 <Button onAction="#handleBackToCatalog" prefHeight="37.0" prefWidth="179.0" styleClass="beige-button" text="Torna al catalogo" />
            </graphic>
       </Menu>
       <Menu mnemonicParsing="false">
            <graphic>
                 <Button onAction="#handleLogout" prefHeight="32.0" prefWidth="98.0" styleClass="beige-button" text="Logout" />
            </graphic>
       </Menu>
   </MenuBar>
     <Label alignment="CENTER" prefHeight="26.0" prefWidth="1518.0" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="I MIEI ORDINI" />

    <TableView fx:id="orderTable" prefHeight="289.0" prefWidth="1460.0">
        <columns>
            <TableColumn fx:id="orderIdColumn" prefWidth="90" text="ID Ordine" />
            <TableColumn fx:id="deliveryColumn" prefWidth="120" text="Modalità" />
            <TableColumn fx:id="addressColumn" prefWidth="220" text="Indirizzo" />
            <TableColumn fx:id="pickupDateColumn" prefWidth="158.4000244140625" text="Data ritiro" />
            <TableColumn fx:id="pickupTimeColumn" prefWidth="158.39996337890625" text="Ora ritiro" />
            <TableColumn fx:id="paymentColumn" prefWidth="156.800048828125" text="Pagamento" />
            <TableColumn fx:id="totalColumn" prefWidth="179.199951171875" text="Totale" />
            <TableColumn fx:id="dateColumn" prefWidth="191.199951171875" text="Data ordine" />
            <TableColumn fx:id="statusColumn" prefWidth="182.4000244140625" text="Stato" />
        </columns>
    </TableView>

    <Label alignment="CENTER" prefHeight="0.0" prefWidth="251.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Dettagli ordine selezionato:" />

    <TableView fx:id="orderItemsTable" prefHeight="264.0" prefWidth="1460.0">
        <columns>
            <TableColumn fx:id="productColumn" prefWidth="545.600025177002" text="Prodotto" />
            <TableColumn fx:id="quantityColumn" prefWidth="466.4000244140625" text="Quantità" />
            <TableColumn fx:id="unitPriceColumn" prefWidth="445.60003662109375" text="Prezzo unitario" />
        </columns>
    </TableView>

    <Label fx:id="bouquetDetailsLabel" alignment="CENTER" prefHeight="17.0" prefWidth="1460.0" style="-fx-font-size: 14px;" styleClass="text-field" text="Questo ordine non contiene un bouquet personalizzato." wrapText="true" />

    <Label fx:id="messageLabel" />

</VBox>
