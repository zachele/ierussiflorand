<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="800" prefWidth="1500" styleClass="app-root" stylesheets="@../../../../StyleDarkPremium.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.shopflowers.controller.graphic.ChangePasswordGraphicController">

    <VBox alignment="CENTER" spacing="20" stylesheets="@../../../../StyleDarkPremium.css">

        <VBox alignment="CENTER" maxWidth="420" spacing="18" styleClass="login-card">

            <!-- TITOLO -->
            <VBox alignment="CENTER" spacing="6">
                <Label styleClass="login-title" text="Cambio Password" />
                <Label styleClass="login-subtitle" text="Aggiorna le tue credenziali" />
            </VBox>

            <!-- FORM -->
            <VBox maxWidth="300" spacing="12">

                <TextField fx:id="usernameField" prefHeight="44" promptText="Username" />

                <PasswordField fx:id="oldPasswordField" prefHeight="44" promptText="Password attuale" />

                <PasswordField fx:id="newPasswordField" prefHeight="44" promptText="Nuova password" />

                <PasswordField fx:id="confirmPasswordField" prefHeight="44" promptText="Conferma password" />
            </VBox>

            <!-- BOTTONI -->
            <HBox alignment="CENTER" spacing="10">
                <Button onAction="#handleChangePassword" prefWidth="120" styleClass="login-primary-button" text="Aggiorna" />

                <Button onAction="#handleBackToLogin" prefWidth="120" styleClass="login-secondary-button" text="Indietro" />
            </HBox>

        </VBox>

         <!-- MESSAGGI -->
         <Label fx:id="messageLabel" alignment="CENTER" styleClass="message-label" text="" wrapText="true" />
    </VBox>
</StackPane>
