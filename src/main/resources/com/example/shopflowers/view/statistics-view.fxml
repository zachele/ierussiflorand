<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800" prefWidth="1500" spacing="18" style="-fx-padding: 20;" styleClass="app-root" stylesheets="@../../../../StyleDarkPremium.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.shopflowers.controller.graphic.StatisticsGraphicController">

    <MenuBar nodeOrientation="RIGHT_TO_LEFT">
        <menus>

            <Menu mnemonicParsing="false">
                <graphic>
                    <Button onAction="#handleBackToAdmin" styleClass="secondary-button" text="Torna indietro" />
                </graphic>
                <items>
                    <MenuItem mnemonicParsing="false" text="Back" visible="false" />
                </items>
            </Menu>

            <Menu mnemonicParsing="false">
                <graphic>
                    <Button onAction="#handleLogout" styleClass="beige-button" text="Logout" />
                </graphic>
                <items>
                    <MenuItem mnemonicParsing="false" text="Logout" visible="false" />
                </items>
            </Menu>
        </menus>
    </MenuBar>
        <Label styleClass="page-title" text="Statistiche Vendite" />

    <Label styleClass="page-subtitle" text="Panoramica sintetica su ordini, ricavi, utenti e distribuzione dei prodotti venduti." />

    <HBox alignment="CENTER" spacing="24">

        <!-- BLOCCO STATISTICHE -->
        <VBox prefWidth="420" spacing="14" styleClass="app-card">

            <Label styleClass="section-label" text="Riepilogo generale" />

            <VBox spacing="10">
                <Label styleClass="statistics-label" text="Totale ordini" />
                <Label fx:id="totalOrdersLabel" styleClass="statistics-value" />

                <Label styleClass="statistics-label" text="Totale ricavi" />
                <Label fx:id="totalRevenueLabel" styleClass="statistics-value" />

                <Label styleClass="statistics-label" text="Ordini consegnati" />
                <Label fx:id="deliveredOrdersLabel" styleClass="statistics-value" />

                <Label styleClass="statistics-label" text="Ordini attivi" />
                <Label fx:id="activeOrdersLabel" styleClass="statistics-value" />

                <Label styleClass="statistics-label" text="Clienti registrati" />
                <Label fx:id="totalClientsLabel" styleClass="statistics-value" />

                <Label styleClass="statistics-label" text="Operatori registrati" />
                <Label fx:id="totalOperatorsLabel" styleClass="statistics-value" />

                <Label styleClass="statistics-label" text="Prodotto più venduto" />
                <Label fx:id="mostSoldProductLabel" styleClass="statistics-value" />
            </VBox>
        </VBox>

        <!-- BLOCCO GRAFICO -->
        <VBox prefWidth="950" spacing="12" styleClass="app-card">

            <Label styleClass="section-label" text="Distribuzione prodotti venduti" />

            <PieChart fx:id="statisticsPieChart" prefHeight="560" prefWidth="900" />
        </VBox>

    </HBox>

    <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" />

</VBox>
