<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.shopflowers.controller.graphic.CompanyInfoGraphicController"
      spacing="15"
      prefWidth="900"
      prefHeight="650"
      style="-fx-padding: 20;">

    <Label text="Ierussi Flowers - Informazioni Azienda"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <Label text="Chi siamo"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label wrapText="true"
           text="Shop Flowers è un'attività dedicata alla vendita di fiori, nata con l'obiettivo di offrire qualità, cura estetica e attenzione al cliente. L'azienda propone prodotti per occasioni speciali, eventi e acquisti quotidiani." />

    <Label text="Giorni lavorativi"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label text="Lunedì - Sabato" />

    <Label text="Orari di apertura"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label text="08:30 - 13:00 / 15:30 - 19:30" />

    <Label text="Indirizzo"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label text="Via dei Fiori 25, Roma" />

    <Label text="Posizione"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label wrapText="true"
           text="L'azienda si trova in zona centrale, facilmente raggiungibile sia in auto sia con i mezzi pubblici.
            È disponibile il ritiro in sede per gli ordini effettuati tramite applicazione." />

    <Label text="Contatti"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label text="Telefono: 06 1234567" />
    <Label text="Email: info@shopflowers.it" />

    <Button text="Torna al catalogo" onAction="#handleBackToCatalog"/>

    <Label fx:id="messageLabel" text="" />
</VBox>